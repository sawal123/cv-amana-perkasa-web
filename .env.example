# Salin menjadi .env (lokal) dan set nilai yang sama di bagian
# Environment Variables pada cPanel Setup Node.js App.

# Origin deployment: dasar untuk canonical, robots.txt, sitemap.xml, dan JSON-LD.
# Wajib origin saja — URL absolut http/https tanpa path/query/hash/kredensial.
# Produksi wajib https. Contoh: https://amanaperkasa.co.id
SITE_URL=

# MySQL lokal di shared hosting selalu 127.0.0.1, bukan "localhost"
# (localhost memicu socket connection pada sebagian konfigurasi).
DATABASE_URL=mysql://USER:PASS@127.0.0.1:3306/namacpanel_amana_cms

# Wajib diisi. Buat dengan: openssl rand -base64 48
AUTH_SECRET=

# Hanya dipakai scripts/seed.ts saat membuat admin pertama.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Direktori penyimpanan fisik gambar yang diunggah lewat admin.
# Kosongkan untuk lokal (default: <cwd>/public/uploads).
# Di produksi (managed Node yang mengganti direktori aplikasi tiap deploy),
# isi dengan path ABSOLUT yang persisten & writable di luar direktori rilis.
# Harus absolut — nilai relatif ditolak health check. Contoh (jangan pakai
# username/path asli di file yang di-commit):
#   UPLOAD_STORAGE_DIR=/absolute/persistent/path/to/uploads
UPLOAD_STORAGE_DIR=

