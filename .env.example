# Salin menjadi .env (lokal) dan set nilai yang sama di bagian
# Environment Variables pada cPanel Setup Node.js App.

# MySQL lokal di shared hosting selalu 127.0.0.1, bukan "localhost"
# (localhost memicu socket connection pada sebagian konfigurasi).
DATABASE_URL=mysql://USER:PASS@127.0.0.1:3306/namacpanel_amana_cms

# Wajib diisi. Buat dengan: openssl rand -base64 48
AUTH_SECRET=

# Hanya dipakai scripts/seed.ts saat membuat admin pertama.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

