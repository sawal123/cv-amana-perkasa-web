{
  "name": "cv-amana-perkasa-company-profile",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file=.env scripts/migrate.ts",
    "db:seed": "tsx --env-file=.env scripts/seed.ts",
    "db:seed:sql": "tsx --env-file=.env scripts/seed.ts --emit-sql",
    "content:check": "tsx --env-file=.env scripts/content-readiness.ts",
    "production:preflight": "node --env-file=.env scripts/production-preflight.mjs",
    "deploy:pack": "node scripts/pack.mjs && node scripts/deploy-verify.mjs",
    "deploy:verify": "node scripts/deploy-verify.mjs",
    "production:smoke": "node scripts/production-smoke.mjs"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.3",
    "jose": "^6.2.12",
    "motion": "14.0.0",
    "mysql2": "^3.24.5",
    "next": "16.3.8",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.3.0",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "drizzle-kit": "^0.31.11",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "5.9.2"
  }
}
